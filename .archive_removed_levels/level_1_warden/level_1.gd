extends LevelBase
## Level 1 director: "The Warden's Game" (♦ / ♣).
## Walk into the cell -> take your place at the table -> card game (WardenGame
## + CardUI) with the other players as 3D figures -> exit door opens on win.
## Geometry is generated by tools/scene_builder/build_level_1.gd.

const RULES_TITLE := "THE WARDEN'S GAME   ♦ ♣"
const RULES_BODY := """Survive three nights in this cell.

Keep FOOD, POWER and MORALE above zero.
Never let THREAT reach ten.

Each day and each night, the Warden deals a card.
The others will follow your orders —
as long as they trust you.

Hover over a choice to see what it affects."""

## Figure spots for 3 or 4 players (names of Marker3D children of %NPCSpots).
const SPOTS: Dictionary[int, Array] = {3: ["Left", "BackCenter", "Right"], 4: ["Left", "BackLeft", "BackRight", "Right"]}
const EXECUTION_CAUSES: Array[StringName] = [&"bait", &"vote", &"betrayal", &"judgment"]

@onready var _fx: HorrorFX = %HorrorFX
@onready var _announcer: Announcer = %Announcer
@onready var _card_ui: CardUI = %CardUI
@onready var _seat: Interactable = %TableSeat
@onready var _table_camera: Camera3D = %TableCamera
@onready var _spots: Node3D = %NPCSpots
@onready var _lamp: FlickerLight = %TableLamp
@onready var _screen: Label3D = %WardenScreen
@onready var _hound: StalkerFigure = %Hound
@onready var _exit_door: Door = %ExitDoor
@onready var _exit_trigger: TriggerZone = %ExitTrigger

var _game := WardenGame.new()
var _figures: Dictionary[int, NPCFigure] = {}
var _seated := false
var _lamp_energy := 0.0


func _ready() -> void:
	super()
	_lamp_energy = _lamp.on_energy
	_game.setup()
	_spawn_figures()
	_card_ui.bind_game(_game)
	_game.phase_changed.connect(_on_phase)
	_game.npcs_changed.connect(_on_npcs_changed)
	_game.resources_changed.connect(_on_resources_changed)
	_game.npc_died.connect(_on_npc_died)
	_game.warden_spoke.connect(func(line: String) -> void: _announcer.announce(line, false))
	_game.effect_requested.connect(_on_effect)
	_game.game_won.connect(_on_won)
	_game.game_lost.connect(_on_lost)
	_seat.interacted.connect(_sit.unbind(1))
	_exit_trigger.triggered.connect(_on_exit.unbind(1))
	_intro()


func _intro() -> void:
	await _wait(1.2)
	await _announcer.announce("Welcome, players, to the Warden's Game.")
	EventBus.message_requested.emit(RULES_TITLE, RULES_BODY)
	await EventBus.message_closed
	EventBus.objective_changed.emit("Take your place at the table")


func _sit() -> void:
	if _seated:
		return
	_seated = true
	_seat.enabled = false
	player.set_input_enabled(false)
	EventBus.objective_changed.emit("")
	await SceneTransition.fade_out(0.5)
	player.set_model_visible(false)
	_table_camera.make_current()
	GameManager.set_state(GameManager.State.UI)
	await SceneTransition.fade_in(0.6)
	_card_ui.open()
	_game.begin()


# =========================================================================
# Game -> world
# =========================================================================

func _spawn_figures() -> void:
	var spot_names: Array = SPOTS[clampi(_game.npcs.size(), 3, 4)]
	for i in _game.npcs.size():
		var spot := _spots.get_node(NodePath(spot_names[i])) as Node3D
		var figure := NPCFigure.new().setup(_game.npcs[i])
		figure.name = "NPC_" + _game.npcs[i].name
		add_child(figure)
		figure.global_transform = spot.global_transform
		_figures[_game.npcs[i].id] = figure


func _on_phase(day: int, is_night: bool) -> void:
	_screen.text = "♦  ♣\n\nDAY %d\n%s" % [day, "NIGHT" if is_night else ""]
	_on_resources_changed(_game.resources) # night dims the lamp


func _on_npcs_changed(npcs: Array) -> void:
	for npc: WardenNPC in npcs:
		if npc.alive and _figures.has(npc.id):
			_figures[npc.id].set_fear(npc.fear)


## The room reflects the meters: low POWER dims the lamp, high THREAT makes it fail.
func _on_resources_changed(resources: Dictionary) -> void:
	var power: int = resources[&"power"]
	_lamp.on_energy = _lamp_energy * clampf(0.25 + power * 0.1, 0.25, 1.0) * (0.7 if _game.is_night else 1.0)
	_lamp.mode = FlickerLight.Mode.BROKEN if resources[&"threat"] >= 7 or power <= 2 else FlickerLight.Mode.STEADY


func _on_npc_died(npc: WardenNPC, cause: StringName) -> void:
	var figure: NPCFigure = _figures.get(npc.id)
	if figure == null:
		return
	player.add_heartbeat_spike(35.0)
	if cause in EXECUTION_CAUSES:
		figure.execute()
	else:
		figure.vanish()


func _on_effect(effect: StringName) -> void:
	if effect != &"hound":
		return
	# Something crawls past the cell bars.
	_hound.position.z = -4.5
	_hound.appear()
	_hound.rotation.y = 0.0
	_hound.play_animation(&"walk", 0.45)
	player.add_heartbeat_spike(20.0)
	var tween := create_tween()
	tween.tween_property(_hound, "position:z", 4.5, 11.0)
	tween.tween_callback(_hound.vanish)


func _on_won(survivors: Array) -> void:
	var names: PackedStringArray = []
	for npc: WardenNPC in survivors:
		names.append(npc.name)
	GameManager.run_data["level_1_survivors"] = names
	_card_ui.close()
	_screen.text = "♦  ♣\n\nGAME CLEAR"
	_lamp.mode = FlickerLight.Mode.STEADY
	await _wait(0.8)
	await SceneTransition.fade_out(0.6)
	player.set_model_visible(true)
	player.get_camera().make_current()
	GameManager.set_state(GameManager.State.PLAYING)
	player.set_input_enabled(true)
	_exit_door.open()
	await SceneTransition.fade_in(0.8)
	_announcer.announce("Congratulations. Game clear.")
	EventBus.objective_changed.emit("Leave through the exit")


func _on_lost(_reason: StringName, title: String, text: String) -> void:
	_card_ui.close()
	_lamp.turn_off(true)
	_screen.text = "♦  ♣\n\nGAME OVER"
	EventBus.subtitle_requested.emit(title + " — " + text, 5.0)
	player.add_heartbeat_spike(60.0)
	await _wait(1.5)
	await _fx.blink_to(1.0, 1.5)
	player.kill(String(title))


func _on_exit() -> void:
	player.set_input_enabled(false)
	await _fx.blink_to(1.0, 1.2)
	complete_level()


func _wait(seconds: float) -> void:
	await get_tree().create_timer(seconds).timeout
