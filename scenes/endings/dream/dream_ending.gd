extends LevelBase
## Ending, after Level 4: a warm, endless dream. The player walks on still,
## mirror-like water under golden light towards a lone bed; the phone on the
## nightstand is ringing. Turning the alarm off dissolves the dream into light
## and the player wakes up in their own room (the still image under the
## eyelids), then the run ends on the good / bad ending card.
## Geometry is generated by tools/scene_builder/build_dream_ending.gd; this
## script only references nodes marked with unique names (%Name).

const WAKE_ROOM := preload("res://scenes/endings/dream/wake_room.jpg")
const PRELOAD_SOUNDS: Array[StringName] = [&"dream_pad", &"phone_alarm", &"phone_tap", &"inhale"]
const MUSIC_DB := -9.0
const ALARM_DELAY := 3.0 ## seconds after control returns before the phone rings

@onready var _phone: AlarmPhone = %Phone
@onready var _music: ProceduralSound = %DreamMusic
@onready var _water: MeshInstance3D = %Water
@onready var _world_env: WorldEnvironment = %WorldEnvironment

var _overlay: TransitionOverlay
var _water_material: StandardMaterial3D
var _waking := false


func _ready() -> void:
	ProceduralAudio.preload_sounds(PRELOAD_SOUNDS)
	super()
	_water_material = _water.material_override as StandardMaterial3D
	_overlay = TransitionOverlay.new()
	add_child(_overlay)
	_phone.alarm_turned_off.connect(_on_alarm_turned_off)
	_enter_dream()


func _process(delta: float) -> void:
	super(delta)
	# Slow ripples drifting across the water.
	if _water_material:
		_water_material.uv1_offset += Vector3(0.004, 0.0, 0.0025) * delta


# =========================================================================
# 1. Into the light
# =========================================================================

func _enter_dream() -> void:
	GameManager.set_state(GameManager.State.CUTSCENE)
	player.set_input_enabled(false)
	(get_node(^"HUD") as CanvasLayer).visible = false
	_music.volume_db = -40.0
	_music.play()
	create_tween().tween_property(_music, "volume_db", MUSIC_DB, 4.0)
	# The scene loader fades in from white; let the light settle first.
	await _wait(2.0)
	start_level()
	player.set_input_enabled(true)
	(get_node(^"HUD") as CanvasLayer).visible = true
	_say("DREAM_SAY_WHERE", 3.5)
	await _wait(ALARM_DELAY)
	_phone.start_alarm()
	await _wait(1.5)
	_say("DREAM_SAY_ALARM", 3.0)
	EventBus.objective_changed.emit("DREAM_OBJ_ALARM")


# =========================================================================
# 2. Waking up
# =========================================================================

func _on_alarm_turned_off() -> void:
	if _waking:
		return
	_waking = true
	is_running = false
	player.set_input_enabled(false)
	EventBus.objective_changed.emit("")
	(get_node(^"HUD") as CanvasLayer).visible = false
	create_tween().tween_property(_music, "volume_db", -50.0, 4.0).set_trans(Tween.TRANS_SINE)
	await _wait(1.2)

	# The dream dissolves into light...
	var env := _world_env.environment
	create_tween().tween_property(env, "tonemap_exposure", env.tonemap_exposure * 2.5, 2.4)
	await _overlay.fade_to_white(2.4)
	_music.stop()
	# ...then darkness behind closed eyes.
	_overlay.close_eyes()
	await _overlay.animate(&"fade_color", Color(0, 0, 0, 0), 1.2).finished
	await _wait(1.0)

	# Eyes open: their own room, morning light.
	_overlay.set_backdrop(WAKE_ROOM)
	_play(&"inhale", -2.0)
	await _overlay.play_wake_up_sequence()
	await _wait(0.8)
	await _overlay.show_caption("DREAM_SAY_AWAKE", 4.5)
	await _wait(0.6)
	await _overlay.fade_to_black(2.5)
	await _wait(0.8)
	GameManager.finish_dream()


# =========================================================================
# Helpers
# =========================================================================

func _say(key: String, duration: float) -> void:
	EventBus.subtitle_requested.emit(key, duration)


func _play(id: StringName, volume_db: float) -> void:
	var sound := AudioStreamPlayer.new()
	sound.bus = "SFX"
	sound.stream = ProceduralAudio.get_stream(id)
	sound.volume_db = volume_db
	add_child(sound)
	sound.finished.connect(sound.queue_free)
	sound.play()


func _wait(seconds: float) -> void:
	await get_tree().create_timer(seconds).timeout
