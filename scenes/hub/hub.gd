extends LevelBase
## Scene 0 director: wake-up cutscene -> phone invitation -> hallway scares
## -> game-entry lobby -> gate into Level 1.
## Geometry is generated by tools/scene_builder/build_hub.gd; this script
## only references nodes marked with unique names (%Name).

const PHONE_TITLE := "HUB_PHONE_TITLE"
const PHONE_BODY := "HUB_PHONE_BODY"

const PRELOAD_SOUNDS: Array[StringName] = [
	&"drone", &"hum", &"heartbeat", &"slam", &"creak", &"rattle", &"buzz", &"chime",
	&"beep", &"pop", &"alarm", &"shutter", &"click", &"step_0", &"step_1", &"step_2", &"step_3",
]

@onready var _fx: HorrorFX = %HorrorFX
@onready var _announcer: Announcer = %Announcer
@onready var _intro_camera: Camera3D = %IntroCamera
@onready var _room_door: Door = %RoomDoor
@onready var _phone: Examinable = %Phone
@onready var _phone_light: OmniLight3D = %PhoneLight
@onready var _phone_sound: ProceduralSound3D = %PhoneSound
@onready var _hall_trigger: TriggerZone = %HallTrigger
@onready var _scare_trigger: TriggerZone = %ScareTrigger
@onready var _lobby_trigger: TriggerZone = %LobbyTrigger
@onready var _gate_trigger: TriggerZone = %GateTrigger
@onready var _hall_lights: Node3D = %HallLights
@onready var _emergency_lights: Node3D = %EmergencyLights
@onready var _stalker: StalkerFigure = %Stalker
@onready var _rattle_door: Door = %RattleDoor
@onready var _entry_screen: Label3D = %EntryScreen
@onready var _register_phone: Interactable = %RegisterPhone
@onready var _gate: Door = %Gate
@onready var _gate_beacon: Node3D = %GateBeacon
@onready var _alarm: ProceduralSound3D = %Alarm
@onready var _beep: ProceduralSound = %Beep

var _phone_checked := false
var _registered := false


func _ready() -> void:
	ProceduralAudio.preload_sounds(PRELOAD_SOUNDS)
	super()
	_room_door.locked_prompt = "HUB_ROOM_DOOR_STUCK"
	_room_door.set_locked(true)
	_register_phone.enabled = false
	_gate_beacon.visible = false
	_phone.examined.connect(_on_phone_examined)
	_hall_trigger.triggered.connect(_on_hallway_entered.unbind(1))
	_scare_trigger.triggered.connect(_on_scare.unbind(1))
	_lobby_trigger.triggered.connect(_on_lobby_entered.unbind(1))
	_register_phone.interacted.connect(_on_register.unbind(1))
	_gate_trigger.triggered.connect(_on_enter_venue.unbind(1))
	_play_intro()


# =========================================================================
# 1. Wake up
# =========================================================================

func _play_intro() -> void:
	GameManager.set_state(GameManager.State.CUTSCENE)
	player.set_input_enabled(false)
	player.set_model_visible(false)
	_intro_camera.make_current()
	_fx.set_blink(1.0)
	_fx.set_blur(3.0)

	await _wait(2.0)
	await _fx.blink_to(0.55, 1.4)
	await _fx.blink_to(1.0, 0.25)
	await _wait(0.6)
	await _fx.blink_to(0.3, 1.0)
	await _fx.blink_to(0.85, 0.2)
	_fx.blur_to(0.0, 5.0)
	await _fx.blink_to(0.0, 1.5)
	_say("HUB_SAY_HEAD", 3.0)
	await _wait(3.0)
	_say("HUB_SAY_QUIET", 3.5)

	# Sit up and look around the room.
	var tween := create_tween().set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(_intro_camera, "rotation_degrees", Vector3(-8.0, -75.0, 0.0), 4.0)
	tween.parallel().tween_property(_intro_camera, "position", _intro_camera.position + Vector3(0.35, 0.45, -0.25), 4.0)
	await tween.finished
	_phone_buzz_loop()
	await _wait(1.5)
	_say("HUB_SAY_PHONE", 2.5)
	await _wait(2.5)

	await SceneTransition.fade_out(0.8)
	player.set_model_visible(true)
	player.get_camera().make_current()
	_fx.set_blur(0.0)
	start_level()
	player.set_input_enabled(true)
	await SceneTransition.fade_in(1.0)
	EventBus.objective_changed.emit("HUB_OBJ_CHECK_PHONE")


func _phone_buzz_loop() -> void:
	while not _phone_checked:
		_phone_sound.play()
		var tween := create_tween()
		tween.tween_property(_phone_light, "light_energy", 1.2, 0.1)
		tween.tween_property(_phone_light, "light_energy", 0.15, 1.2)
		await _wait(4.0)


func _on_phone_examined() -> void:
	if _phone_checked:
		return
	_phone_checked = true
	_phone.enabled = false
	_phone_light.light_energy = 0.4
	await EventBus.message_closed
	_say("HUB_SAY_JOKE", 3.0)
	await _wait(2.5)
	_room_door.set_locked(false)
	_play_at(_room_door, &"click")
	_say("HUB_SAY_DOOR_UNLOCKED", 3.0)
	EventBus.objective_changed.emit("HUB_OBJ_LEAVE_ROOM")


# =========================================================================
# 2. Hallway
# =========================================================================

func _on_hallway_entered() -> void:
	_room_door.locked_prompt = "HUB_ROOM_DOOR_LOCKED"
	_room_door.set_locked(true)
	_room_door.close(true)
	player.add_heartbeat_spike(30.0)
	await _wait(0.4)
	_say("HUB_SAY_SHOCK", 1.2)
	await _wait(1.6)
	_say("HUB_SAY_LOCKED_BEHIND", 3.0)
	EventBus.objective_changed.emit("HUB_OBJ_FOLLOW_CARDS")


func _on_scare() -> void:
	var lights := _sorted_far_to_near(_hall_lights)
	for i in mini(2, lights.size()):
		lights[i].mode = FlickerLight.Mode.FLICKER
	_stalker.appear()
	player.add_heartbeat_spike(35.0)
	await _wait(1.6)
	_stalker.vanish()
	# Darkness rushes toward the player.
	for light in lights:
		light.turn_off(true)
		await _wait(0.28)
	_rattle_door.rattle()
	player.add_heartbeat_spike(30.0)
	await _wait(1.4)
	var index := 0
	for light: FlickerLight in _emergency_lights.get_children():
		light.turn_on(FlickerLight.Mode.BROKEN if index % 2 == 1 else FlickerLight.Mode.STEADY)
		index += 1
	_say("HUB_SAY_WHOS_THERE", 3.0)
	EventBus.objective_changed.emit("HUB_OBJ_KEEP_MOVING")


# =========================================================================
# 3. Entry lobby
# =========================================================================

func _on_lobby_entered() -> void:
	_entry_screen.text = "ENTRY OPEN"
	_register_phone.enabled = true
	EventBus.objective_changed.emit("HUB_OBJ_TAKE_PHONE")
	await _announcer.announce("HUB_PA_ENTRY_OPEN")


func _on_register() -> void:
	if _registered:
		return
	_registered = true
	_register_phone.enabled = false
	(_register_phone.get_parent() as Node3D).visible = false
	EventBus.objective_changed.emit("")
	_entry_screen.text = "REGISTERED\n\nPLAYERS : 1"
	await _announcer.announce("HUB_PA_REGISTERED")
	_entry_screen.text = "GAME\n\nTHE MAZE OF WHISPERS\n\nDIFFICULTY   ♦  ♣"
	await _announcer.announce("HUB_PA_GAME_INFO")
	await _announcer.announce("HUB_PA_SOON", false)
	for i in range(5, 0, -1):
		_entry_screen.text = "GAME START\n\n%d" % i
		_beep.play()
		player.add_heartbeat_spike(4.0)
		await _wait(1.0)
	_entry_screen.text = "GAME START"
	_gate_beacon.visible = true
	var spin := _gate_beacon.create_tween().set_loops()
	spin.tween_property(_gate_beacon, "rotation:y", TAU, 1.2).from(0.0)
	_alarm.play()
	for light: FlickerLight in _emergency_lights.get_children():
		light.mode = FlickerLight.Mode.BROKEN
	_gate.open()
	EventBus.objective_changed.emit("HUB_OBJ_ENTER_VENUE")


func _on_enter_venue() -> void:
	player.set_input_enabled(false)
	EventBus.objective_changed.emit("")
	_announcer.announce("HUB_PA_GAME_START")
	await _fx.blink_to(1.0, 2.0)
	_alarm.stop()
	complete_level()


# =========================================================================
# Helpers
# =========================================================================

func _wait(seconds: float) -> void:
	await get_tree().create_timer(seconds).timeout


func _say(text: String, duration: float) -> void:
	EventBus.subtitle_requested.emit(text, duration)


func _play_at(target: Node3D, id: StringName) -> void:
	var sound := AudioStreamPlayer3D.new()
	sound.stream = ProceduralAudio.get_stream(id)
	target.add_child(sound)
	sound.position = Vector3(0.8, 1.0, 0.0)
	sound.finished.connect(sound.queue_free)
	sound.play()


func _sorted_far_to_near(parent: Node3D) -> Array[FlickerLight]:
	var result: Array[FlickerLight] = []
	for child in parent.get_children():
		if child is FlickerLight:
			result.append(child)
	result.sort_custom(func(a: FlickerLight, b: FlickerLight) -> bool: return a.global_position.z < b.global_position.z)
	return result
